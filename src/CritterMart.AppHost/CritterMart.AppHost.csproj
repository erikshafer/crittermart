<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>crittermart-apphost</UserSecretsId>
    <!-- ASPIRE010 (new in Aspire 13.5) warns that AspireUseCliBundle is false, its own default.
         Setting it true would resolve DCP and the dashboard from an INSTALLED Aspire CLI instead of
         from NuGet. CritterMart deliberately keeps the NuGet-restored path: the demo runbook boots
         the AppHost with `dotnet run` on the http launch profile, and CI restores
         from nuget.org, so requiring a machine-global CLI would add a prerequisite to a repo whose
         whole point is that it clones and runs. Suppressing is the documented option for this case
         (https://aspire.dev/diagnostics/aspire010/). Revisit if we ever adopt an aspire-CLI-only feature. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CritterMart.Catalog\CritterMart.Catalog.csproj" />
    <ProjectReference Include="..\CritterMart.CritterWatch\CritterMart.CritterWatch.csproj" />
    <ProjectReference Include="..\CritterMart.Identity\CritterMart.Identity.csproj" />
    <ProjectReference Include="..\CritterMart.Inventory\CritterMart.Inventory.csproj" />
    <ProjectReference Include="..\CritterMart.Orders\CritterMart.Orders.csproj" />
    <ProjectReference Include="..\CritterMart.Seeding\CritterMart.Seeding.csproj" />
  </ItemGroup>

</Project>
