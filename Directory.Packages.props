<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- .NET Aspire 13 (orchestration; ADR 004) -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.4.6" />
  </ItemGroup>
  <!-- Observability (OpenTelemetry; ADR 005) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.8.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
  </ItemGroup>
  <!-- Critter Stack 2026 line (Wolverine 6 / Marten 9 / JasperFx 2). Currently 6.34.0.
       COUPLING NOTE — the app is in EXACT lockstep with CritterWatch. CritterWatch 1.1.0-beta.1
       (installed below) is compiled against WolverineFx(.Marten) 6.34.0, and these pins match it exactly.
       Running a HIGHER WolverineFx than the version CritterWatch targets throws a startup TypeLoadException
       in Wolverine.Marten's projection-distribution internals
       (EventSubscriptionAgentFamily.TryRebuildRegisteredProjectionAsync); there is only one Wolverine.Marten
       per process, so a live CritterWatch console needs the EXACT version it was built against.
       6.35.0 exists and is DELIBERATELY NOT TAKEN — it would re-open the lead this restores. To move the
       Wolverine line, first read the next CritterWatch nuspec, take the WolverineFx version it declares,
       and pin BOTH blocks to that version in the same commit. Never bump one without the other.
       History: coupling diagnosed 2026-06-24 (CW alpha.3 / 6.12.0); CW beta.1 / 6.16.0 (2026-06-30);
       owner-accepted 1-minor lead at CW beta.4 / 6.18.0-target + app 6.19.0 (2026-07-16), taken because the
       console was non-bootable (trial expired 2026-07-10) so the TypeLoadException was latent; lead RETIRED
       and exact lockstep restored at CW 1.1.0-beta.1 / 6.34.0 (2026-09-09). The trial is still expired, so
       the console runs read-only Free, but the pins no longer depend on that being true.
       See the dependency-update runbook (docs/skills/updating-critter-stack-dependencies). -->
  <ItemGroup>
    <PackageVersion Include="WolverineFx" Version="6.34.0" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.34.0" />
    <PackageVersion Include="WolverineFx.HealthChecks" Version="6.34.0" />
    <PackageVersion Include="WolverineFx.Http" Version="6.34.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.34.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.34.0" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.34.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.34.0" />
  </ItemGroup>
  <!-- EF Core provider — the Identity spike runs Wolverine over EF Core / Npgsql instead of Marten
       (the persistence-agnostic teaching beat; a data store per ADR 009). .NET 10 / EF Core 10 line. -->
  <ItemGroup>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>
  <!-- Real authentication for Identity (ADR 023). ASP.NET Core Identity is the user store + credential
       handling (UserManager/SignInManager) on the same EF-Core/`identity` schema; JwtBearer provides BOTH
       the resource servers' offline token validation AND — via its bundled Microsoft.IdentityModel.* stack
       (JsonWebTokenHandler, SecurityTokenDescriptor) — Identity's token MINTING, so issuer and validator
       share one IdentityModel version line (no standalone JsonWebTokens pin to skew). .NET 10 line, tracks
       the aspnetcore runtime patch line (currently 10.0.10; CI restores on the floating 10.0.x SDK). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
  </ItemGroup>
  <!-- CritterWatch monitoring console + per-service client (out-of-band trial). 1.1.0-beta.1 is compiled
       against WolverineFx(.Marten) 6.34.0, which is exactly what the Wolverine block above pins — see that
       comment for the coupling rule. These two packages and the eight WolverineFx pins move as ONE unit;
       a half-pair bump (either side alone) is the documented failure mode. 1.0.1 is the current GA, but it
       targets WolverineFx 6.29.1, five minors further back; the beta is taken deliberately to buy the
       newer Wolverine line while keeping lockstep. -->
  <ItemGroup>
    <PackageVersion Include="CritterWatch" Version="1.1.0-beta.1" />
    <PackageVersion Include="Wolverine.CritterWatch" Version="1.1.0-beta.1" />
  </ItemGroup>
  <!-- CritterWatch (still as of 1.1.0-beta.1) transitively pulls MessagePack 2.5.302, which has a
       high-severity CVE (GHSA-hv8m-jj95-wg3x). The fix is MessagePack >= 3.0.214 — a major version
       bump CritterWatch has not yet taken. Re-verified unaddressed on 1.1.0-beta.1 (2026-09-09; was
       2.5.302 on beta.4 and beta.1, 2.5.301 on alpha.3 and on the 1.0.1 GA). Suppress until an upstream
       CritterWatch release moves to MessagePack 3.x. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-hv8m-jj95-wg3x" />
  </ItemGroup>
  <!-- API documentation (Swagger UI) -->
  <ItemGroup>
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>
  <!-- Test packages -->
  <ItemGroup>
    <PackageVersion Include="Alba" Version="8.5.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
</Project>